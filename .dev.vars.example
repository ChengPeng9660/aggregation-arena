# Copy this file to .dev.vars for local development. Never commit real keys.
TAVILY_API_KEY=tvly-your-key

# Production uses Poe's OpenAI-compatible endpoint. The API key is stored only
# as a Cloudflare encrypted secret; never commit a real key here.
PROPHET_MODEL_GATEWAY_URL=https://api.poe.com/v1/chat/completions
PROPHET_MODEL_GATEWAY_API_KEY=replace-with-poe-key

# Optional JSON map from Prophet Arena slug to the deployment alias exposed by
# your gateway. Both base forecasters and Agent Harnesses share this gateway.
# Omit this variable when the gateway accepts the public slugs directly.
PROPHET_MODEL_GATEWAY_MODE=external
PROPHET_AI_GATEWAY_ID=default
PROPHET_CLOUDFLARE_MODEL_ID_MAP={"gemini-3.6-flash":"google/gemini-3.6-flash","claude-fable-5":"anthropic/claude-fable-5","gemini-3.1-pro":"google/gemini-3.1-pro","gpt-5.6-sol":"openai/gpt-5.6-sol","gpt-5.5-high":"openai/gpt-5.5","claude-opus-4.8-thinking":"anthropic/claude-opus-4.8","kimi-k3":"moonshotai/kimi-k3","thinking-machines-zs-v2":"thinkingmachines/inkling","claude-sonnet-4.6":"anthropic/claude-sonnet-4.6","grok-4.5":"xai/grok-4.5","glm-5.2":"@cf/zai-org/glm-5.2","deepseek-v4-pro":"deepseek/deepseek-v4-pro","qwen-3.7-plus":"alibaba/qwen3.7-plus","grok-4.3":"xai/grok-4.3","inkling-256k":"thinkingmachines/inkling-256k","minimax-m2.7":"minimax/m2.7"}
PROPHET_MODEL_ID_MAP={"gemini-3.6-flash":"gemini-3.6-flash","claude-fable-5":"claude-fable-5","gemini-3.1-pro":"gemini-3.1-pro","gpt-5.6-sol":"gpt-5.6-sol","gpt-5.5-high":"gpt-5.5","claude-opus-4.8-thinking":"claude-opus-4.8","kimi-k3":"kimi-k3","thinking-machines-zs-v2":"inkling","claude-sonnet-4.6":"claude-sonnet-4.6","grok-4.5":"grok-4.5","glm-5.2":"glm-5.2","deepseek-v4-pro":"deepseek-v4-pro","qwen-3.7-plus":"qwen3.7-plus","grok-4.3":"grok-4.3","inkling-256k":"inkling-256k","minimax-m2.7":"minimax-m2.7"}

# Keep Cloudflare-only models disabled while external mode is active. After
# funding and smoke-testing Unified Billing, switch to cloudflare-hybrid and
# remove the successfully tested IDs from this list.
PROPHET_DISABLED_MODEL_IDS=["claude-fable-5","gpt-5.6-sol","gpt-5.5-high","qwen-3.7-plus","inkling-256k"]
