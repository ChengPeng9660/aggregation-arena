# Copy this file to .dev.vars for local development. Never commit real keys.
TAVILY_API_KEY=tvly-your-key

# All production inference uses Cloudflare. The map includes the 13 active
# forecasters plus Qwen 3.7 Plus for the two agent harnesses.
PROPHET_MODEL_GATEWAY_MODE=cloudflare-only
PROPHET_AI_GATEWAY_ID=default
PROPHET_CLOUDFLARE_MODEL_ID_MAP={"gemini-3.6-flash":"google/gemini-3.6-flash","gemini-3.1-pro":"google/gemini-3.1-pro","claude-fable-5":"anthropic/claude-fable-5","deepseek-v4-flash":"@cf/deepseek-ai/deepseek-v4-flash-0731","claude-opus-4.8":"anthropic/claude-opus-4.8","claude-sonnet-4.6":"anthropic/claude-sonnet-4.6","grok-4.6":"xai/grok-4.6","deepseek-v4-pro":"deepseek/deepseek-v4-pro","kimi-k3":"moonshotai/kimi-k3","grok-4.5":"xai/grok-4.5","glm-5.2":"@cf/zai-org/glm-5.2","grok-4.3":"xai/grok-4.3","minimax-m2.7":"minimax/m2.7","qwen-3.7-plus":"alibaba/qwen3.7-plus"}

# These exact Workers AI routes require a paid Workers AI billing path.
PROPHET_DISABLED_MODEL_IDS=["deepseek-v4-flash","glm-5.2"]
