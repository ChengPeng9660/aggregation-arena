{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aggregation-arena",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "secrets": {
    "required": [
      "TAVILY_API_KEY",
      "PROPHET_MODEL_GATEWAY_URL",
      "PROPHET_MODEL_GATEWAY_API_KEY"
    ]
  },
  "triggers": {
    "crons": ["0 * * * *", "10 0 * * *", "20 * * * *", "30 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aggregation-arena-production",
      "database_id": "8351e8d1-5d92-4afd-b3b8-2f22c84b24b5",
      "migrations_dir": "./drizzle"
    }
  ]
}
