{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aggregation-arena",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "routes": [
    { "pattern": "aggrena.com", "custom_domain": true },
    { "pattern": "www.aggrena.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "PROPHET_MODEL_GATEWAY_MODE": "cloudflare-hybrid",
    "PROPHET_AI_GATEWAY_ID": "default",
    "PROPHET_MODEL_GATEWAY_URL": "https://api.poe.com/v1/chat/completions",
    "PROPHET_CLOUDFLARE_MODEL_ID_MAP": "{\"gemini-3.6-flash\":\"google/gemini-3.6-flash\",\"gemini-3.1-pro\":\"google/gemini-3.1-pro\",\"claude-fable-5\":\"anthropic/claude-fable-5\",\"deepseek-v4-flash\":\"@cf/deepseek-ai/deepseek-v4-flash-0731\",\"claude-opus-4.8\":\"anthropic/claude-opus-4.8\",\"claude-sonnet-4.6\":\"anthropic/claude-sonnet-4.6\",\"grok-4.6\":\"xai/grok-4.6\",\"deepseek-v4-pro\":\"deepseek/deepseek-v4-pro\",\"kimi-k3\":\"moonshotai/kimi-k3\",\"grok-4.5\":\"xai/grok-4.5\",\"glm-5.2\":\"@cf/zai-org/glm-5.2\",\"grok-4.3\":\"xai/grok-4.3\",\"minimax-m2.7\":\"minimax/m2.7\"}",
    "PROPHET_MODEL_ID_MAP": "{\"gpt-5.6-sol\":\"gpt-5.6-sol\",\"gemini-3.6-flash\":\"gemini-3.6-flash\",\"gemini-3.1-pro\":\"gemini-3.1-pro\",\"claude-fable-5\":\"claude-fable-5\",\"gpt-5.5\":\"gpt-5.5\",\"deepseek-v4-flash\":\"deepseek-v4-flash\",\"claude-opus-4.8\":\"claude-opus-4.8\",\"claude-sonnet-4.6\":\"claude-sonnet-4.6\",\"grok-4.6\":\"grok-4.6\",\"deepseek-v4-pro\":\"deepseek-v4-pro\",\"kimi-k3\":\"kimi-k3\",\"grok-4.5\":\"grok-4.5\",\"glm-5.2\":\"glm-5.2\",\"qwen-3.6-plus\":\"qwen3.6-plus-t\",\"thinking-machines-zs-v2\":\"inkling\",\"muse-spark-1.1\":\"muse-spark-1-1\",\"grok-4.3\":\"grok-4.3\",\"foresight-v3\":\"foresight-v3\",\"minimax-m2.7\":\"minimax-m2.7\"}",
    "PROPHET_RESPONSES_MODEL_IDS": "[\"gpt-5.6-sol\",\"gpt-5.5\",\"foresight-v3\"]",
    "PROPHET_DISABLED_MODEL_IDS": "[]"
  },
  "secrets": {
    "required": [
      "TAVILY_API_KEY",
      "PROPHET_MODEL_GATEWAY_API_KEY"
    ]
  },
  "triggers": {
    "crons": ["0 * * * *", "10 0 * * *", "20 * * * *", "30 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "ARENA_SNAPSHOT_CACHE",
      "id": "292d5cb40431412396bcbcb2ad8e5f3c"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aggregation-arena-production",
      "database_id": "8351e8d1-5d92-4afd-b3b8-2f22c84b24b5",
      "migrations_dir": "./drizzle"
    }
  ]
}
